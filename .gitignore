# Binaries
/resume-builder
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/
/dist/

# Go build & test
*.test
*.out
coverage.out
*.coverprofile

# Dependency directories
vendor/

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Tool caches. mypy, pytest and ruff each drop a .gitignore containing `*`
# inside their own cache directory, so these are already invisible to git —
# but only for as long as those tools keep doing it. Named here so the repo
# does not depend on that.
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node
node_modules/

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

.env

# Database backups (bun run db:backup)
/backups/

# Screenshot capture staging (see apps/web/scripts/capture-shots.mjs)
apps/web/.shots-staging/
