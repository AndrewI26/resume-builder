# For docker-compose.yml on a server: copy this to .env at the repo root.
# Local development uses .env.example instead.

# The site's address, as the reverse proxy serves it. Google sign in sends
# people back here, and the API is served under its /api.
PUBLIC_URL=https://resume.example.com

# Where the web container copies the built app; the reverse proxy serves it.
WEB_ROOT=/srv/resume-builder/web-root

# Signs login tokens. Generate one with: openssl rand -hex 32
SECRET_KEY=

# Postgres. It is only reachable from inside the stack, but the password
# still guards the data volume.
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=
POSTGRES_DB=resume_db

# Google sign in, optional. Register
# https://<your-domain>/api/auth/google/callback as the redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional:
# The loopback port the reverse proxy reaches the API on.
# BACKEND_PORT=8000
# How many PDF compiles the worker container runs at once.
# PDF_WORKER_COUNT=3
