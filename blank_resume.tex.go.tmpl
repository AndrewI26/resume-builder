%-------------------------
% Custom commands
\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2pt}}
  }
}

\newcommand{\classesList}[4]{
    \item\small{
        {#1 #2 #3 #4 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{1.0\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & \textbf{\small #2} \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubSubheading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \textit{\small#1} & \textit{\small #2} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{1.001\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 & \textbf{\small #2}\\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubItem}[1]{\resumeItem{#1}\vspace{-4pt}}

\renewcommand\labelitemi{$\vcenter{\hbox{\tiny$\bullet$}}$}
\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.0in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

%-------------------------------------------
%%%%%%  RESUME STARTS HERE  %%%%%%%%%%%%%%%%%%%%%%%%%%%%

\usepackage[top=.5cm, bottom=0cm, left=1cm, right=1cm]{geometry}
\begin{document}


%----------HEADING----------
\begin{center}
    {\Huge \scshape {{ .Basics.Name | latexEscape }}} \\ \vspace{1pt}
    {{- if .Basics.Email }}
    \href{mailto:{{ .Basics.Email }}}{\raisebox{-0.2\height}\faEnvelope\  \underline{{ .Basics.Email | latexEscape }}} ~
    {{- end }}
    {{- if .Basics.LinkedIn }}
    \href{{"{"}}{{ .Basics.LinkedIn }}{{"}"}}{\raisebox{-0.2\height}\faLinkedin\ \underline{{ .Basics.LinkedInText | latexEscape }}} ~
    {{- end }}
    {{- if .Basics.GitHub }}
    \href{{"{"}}{{ .Basics.GitHub }}{{"}"}}{\raisebox{-0.2\height}\faGithub\ \underline{{ .Basics.GitHubText | latexEscape }}} ~
    {{- end }}
    {{- if .Basics.Website }}
    \href{{"{"}}{{ .Basics.Website }}{{"}"}}{\raisebox{-0.2\height}\faInternetExplorer\ \underline{{ .Basics.WebsiteText | latexEscape }}} ~
    {{- end }}
\end{center}

{{- if .Skills.Categories }}
%-----------PROGRAMMING SKILLS-----------
\section{Skills}
 \begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
    {{- range .Skills.Categories }}
      \textbf{ {{ .Label | latexEscape }} }{: {{ .Items | latexEscape }} } \\
    {{- end }}
    }}
 \end{itemize}
 \vspace{-20pt}
{{- end }}

{{- if .Experience }}
%-----------EXPERIENCE-----------
\section{Experience}
  \resumeSubHeadingListStart
    {{- range .Experience }}
    \resumeSubheading
      { {{- if .CompanyURL -}}\textbf{\href{{"{"}}{{ .CompanyURL }}{{"}"}}{ {{ .Company | latexEscape }} }}{{- else -}}{{ .Company | latexEscape }}{{- end -}} }{ {{ .DateRange | latexEscape }} }
      { {{ .Role | latexEscape }} }{ {{ .Location | latexEscape }} }
      {{- if .Highlights }}
      \resumeItemListStart
        {{- range .Highlights }}
        \resumeItem{ {{ . | latexEscape }} }
        {{- end }}
      \resumeItemListEnd
      {{- end }}
    {{- end }}
  \resumeSubHeadingListEnd
\vspace{-16pt}
{{- end }}

{{- if .Projects }}
%-----------PROJECTS-----------
\section{Projects}
    \vspace{-5pt}
    \resumeSubHeadingListStart
      {{- range .Projects }}
      \resumeProjectHeading
        { {{- if .URL -}}\href{{"{"}}{{ .URL }}{{"}"}}{\faLink} {{- end -}} \textbf{ {{ .Name | latexEscape }} } {{- if .TechStack }} $|$ \emph{ {{ .TechStack | latexEscape }} }{{- end }} }{ {{ .DateRange | latexEscape }} }
      {{- if .Highlights }}
      \resumeItemListStart
        {{- range .Highlights }}
        \resumeItem{ {{ . | latexEscape }} }
        {{- end }}
      \resumeItemListEnd
      {{- end }}
      \vspace{-16pt}
      {{- end }}
    \resumeSubHeadingListEnd
{{- end }}

{{- if .Education }}
%-----------EDUCATION-----------
\section{Education}
  \resumeSubHeadingListStart
    {{- range .Education }}
    \resumeSubheading
      { {{ .Institution | latexEscape }} }{ {{ .DateRange | latexEscape }} }
      { {{ .Program | latexEscape }} }{ {{ .Location | latexEscape }} }
    {{- if or .AwardsLeft .AwardsRight }}
    \begin{tabularx}{1\textwidth}{
      >{\raggedright\arraybackslash}X
      >{\raggedright\arraybackslash}X }
      \vspace{-15pt}
      {{- if .AwardsLeft }}
      \resumeItemListStart
        {{- range .AwardsLeft }}
        \resumeItem{ {{ . | latexEscape }} }
        {{- end }}
      \resumeItemListEnd
      {{- end }}
      &
      \vspace{-15pt}
      {{- if .AwardsRight }}
      \resumeItemListStart
        {{- range .AwardsRight }}
        \resumeItem{ {{ . | latexEscape }} }
        {{- end }}
      \resumeItemListEnd
      {{- end }}
    \end{tabularx}
    \vspace{-25pt}
    {{- end }}
    {{- end }}
  \resumeSubHeadingListEnd
{{- end }}

\end{document}
