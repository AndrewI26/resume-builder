NODE_ENV=development

# Postgres
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=resume_pass
POSTGRES_DB=resume_db
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
SECRET_KEY=bae47daada0725cf6676db3931c5fbb0e7e131d0c5edab43f5f80052e2dc5a4d

# Google auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend
# Literal on purpose: Vite's loadEnv does not expand ${VAR} references,
# so this must not be written as http://localhost:${BACKEND_PORT}.
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:${FRONTEND_PORT}

# CloudBeaver
CLOUDBEAVER_PORT=8978
CLOUDBEAVER_SERVER_NAME=Resume Builder Dev
CLOUDBEAVER_ADMIN_NAME=cbadmin
CLOUDBEAVER_ADMIN_PASSWORD=cbadmin-dev-password
