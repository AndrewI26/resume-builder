# Postgres
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=resume_pass
POSTGRES_DB=resume_db
POSTGRES_PORT=5432

# Backend
# interpolation is POSIX-style ${VAR}; python-dotenv does not expand bare {VAR}
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
BACKEND_PORT=8000
SECRET_KEY=bae47daada0725cf6676db3931c5fbb0e7e131d0c5edab43f5f80052e2dc5a4d

# Google auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:${BACKEND_PORT}/auth/google/callback

# Frontend
VITE_API_URL=http://localhost:${BACKEND_PORT}
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:${FRONTEND_PORT}

# CloudBeaver
CLOUDBEAVER_PORT=8978
CLOUDBEAVER_SERVER_NAME=Resume Builder Dev
