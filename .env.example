# For local development: copy this to .env at the repo root. A server running
# docker-compose.yml uses .env.prod.example instead.

NODE_ENV=development

# Postgres
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=resume_pass
POSTGRES_DB=resume_db
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
# How many PDF compiles the worker process runs at once
PDF_WORKER_COUNT=3
SECRET_KEY=bae47daada0725cf6676db3931c5fbb0e7e131d0c5edab43f5f80052e2dc5a4d

# Google auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173
# Where people open the app; the API sends them back here after Google sign
# in. On a server, the site's https address (the API is then at /api).
PUBLIC_URL=http://localhost:5173

# CloudBeaver
CLOUDBEAVER_PORT=8978
CLOUDBEAVER_SERVER_NAME=Resume Builder Dev
CLOUDBEAVER_ADMIN_NAME=cbadmin
CLOUDBEAVER_ADMIN_PASSWORD=cbadmin-dev-password
