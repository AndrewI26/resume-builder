<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The app spawns two things it ships with: the API, which is a Python
	  runtime built by PyInstaller, and pdfTeX. Under the hardened runtime both
	  are refused without this, and the refusal looks like the app hanging on
	  startup rather than like a signing problem.
	-->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Electron loads its own framework libraries from inside the bundle. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
